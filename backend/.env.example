# 复制为 .env 后按需修改；生产环境务必更换 SECRET_KEY
SECRET_KEY=dev-secret-do-not-use-in-production
DEBUG=true

# Docker Compose 内主机名为 mysql；本机直连默认 127.0.0.1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=offerpilot
MYSQL_PASSWORD=offerpilot
MYSQL_DB=offerpilot
# 也可用 DATABASE_URL 整体覆盖（例如本地临时用 SQLite 调试）：
# DATABASE_URL=sqlite+pysqlite:///./dev.db

REDIS_URL=redis://127.0.0.1:6379/0

# LLM 配置：glm / deepseek / qwen 三选一（base_url 与模型有预设，可单独覆盖）
LLM_PROVIDER=glm
LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=glm-4-flash

# 简历上传目录
UPLOAD_DIR=uploads

CORS_ORIGINS=["http://localhost:5173"]
